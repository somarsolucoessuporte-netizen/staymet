generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMINISTRADOR
  PROPRIETARIO
  GESTOR
  ANFITRIAO
  HOSPEDE
  PRESTADOR
}

enum PropertyType {
  CASA_PRAIA
  APARTAMENTO
  CHACARA
  CASA_SERRA
  OUTRO
}

enum ReservationStatus {
  CONFIRMADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum BookingSource {
  AIRBNB
  BOOKING
  VRBO
  OLX
  DIRETO
  OUTRO
  BLOQUEIO
}

enum BookingStatus {
  CONFIRMADA
  CANCELADA
}

enum ChannelPlatform {
  AIRBNB
  BOOKING
  VRBO
  OUTRO
}

enum ChannelSyncStatus {
  OK
  ERRO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TaskType {
  LIMPEZA
  MANUTENCAO
  VISTORIA_ENTRADA
  VISTORIA_SAIDA
  OUTRO
}

enum OccurrenceStatus {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
}

enum OccurrencePriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  name       String
  email      String   @unique
  phone      String?
  avatarUrl  String?
  role       Role
  language   String   @default("pt-BR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownedProperties   Property[]     @relation("PropertyOwner")
  managedProperties PropertyUser[]
  tasks             Task[]         @relation("TaskAssignee")
  createdTasks      Task[]         @relation("TaskCreator")
  requests          GuestRequest[]
  occurrences         Occurrence[]      @relation("OccurrenceReporter")
  assignedOccurrences Occurrence[]      @relation("OccurrenceAssignee")
  occurrenceEvents    OccurrenceEvent[]
  notifications     Notification[]
  checkIns          Reservation[]  @relation("CheckedInBy")
  checkOuts         Reservation[]  @relation("CheckedOutBy")
  createdMagicLinks MagicLink[]    @relation("MagicLinkCreator")
  createdExpenses   Expense[]      @relation("ExpenseCreator")
  createdBookings   Booking[]      @relation("BookingCreator")
}

model Property {
  id            String       @id @default(cuid())
  name          String
  description   String?
  type          PropertyType
  address       String
  city          String
  state         String
  zipCode       String?
  country       String       @default("Brasil")
  coverImageUrl String?
  wifiName      String?
  wifiPassword  String?
  checkInTime   String       @default("14:00")
  checkOutTime  String       @default("11:00")
  maxGuests     Int          @default(4)
  rules         String?
  deliveryInstructions String? // instruções para entregadores (como chegar, referência, etc.)
  slug                 String?  @unique // link amigável do guia: /g/<slug>
  locationUrl          String?  // link do Google Maps da casa
  latitude             Float?   // ponto exato da casa (marcado pelo anfitrião)
  longitude            Float?
  suggestionsEnabled   Boolean  @default(true) // mostra a caixinha de sugestões no guia
  icalToken            String?  @unique // token secreto dos links .ics de exportação (Canais)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // MODELO FINANCEIRO
  financeModel      String   @default("HIBRIDO")  // COMISSAO | MENSALIDADE | HIBRIDO
  commissionRate    Decimal? @db.Decimal(5, 2)    // % sobre reservas
  monthlyFee        Decimal? @db.Decimal(10, 2)   // taxa mensal R$
  directCommission  Decimal? @db.Decimal(5, 2)    // % em locações diretas
  paymentDay        Int      @default(10)          // dia do repasse
  financeNotes      String?

  ownerId      String
  owner        User              @relation("PropertyOwner", fields: [ownerId], references: [id])
  users        PropertyUser[]
  reservations Reservation[]
  tasks        Task[]
  occurrences  Occurrence[]
  inventory    InventoryItem[]
  partners     PropertyPartner[]
  inspections  Inspection[]
  expenses     Expense[]
  statements   OwnerStatement[]
  bookings     Booking[]
  channels     CalendarChannel[]
}

model PropertyUser {
  id        String   @id @default(cuid())
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@unique([propertyId, userId])
}

model Reservation {
  id             String            @id @default(cuid())
  guestName      String
  guestEmail     String?
  guestPhone     String?
  guestCount     Int               @default(1)
  checkIn        DateTime
  checkOut       DateTime
  status         ReservationStatus @default(CONFIRMADA)
  totalAmount    Decimal?          @db.Decimal(10, 2)
  platform       String?
  platformCode   String?
  notes          String?
  accessCode     String?           @unique @default(cuid())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  checkedInById  String?
  checkedInBy    User?        @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutById String?
  checkedOutBy   User?        @relation("CheckedOutBy", fields: [checkedOutById], references: [id])

  tasks       Task[]
  requests    GuestRequest[]
  inspections Inspection[]
  magicLinks  MagicLink[]
  occurrences Occurrence[]
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String?
  type         TaskType
  status       TaskStatus @default(PENDENTE)
  scheduledFor DateTime?
  completedAt  DateTime?
  photos       String[]
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId     String
  creator       User         @relation("TaskCreator", fields: [creatorId], references: [id])
  magicLinks    MagicLink[]
}

model Occurrence {
  id          String             @id @default(cuid())
  title       String
  description String
  status      OccurrenceStatus   @default(ABERTA)
  priority    OccurrencePriority @default(MEDIA)
  photos      String[]
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // origem: HOSPEDE | PRESTADOR | ANFITRIAO | GESTOR | PROPRIETARIO | ADMINISTRADOR | PAINEL (legado)
  source          String    @default("PAINEL")
  // categoria operacional (ver lib/occurrences.ts) ou SUGESTAO (caixinha do hóspede)
  category        String    @default("OPERACIONAL")
  reporterName    String?
  reporterContact String?
  archivedAt      DateTime?

  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id])
  reportedById    String?
  reportedBy      User?        @relation("OccurrenceReporter", fields: [reportedById], references: [id])
  assignedToId    String?
  assignedTo      User?        @relation("OccurrenceAssignee", fields: [assignedToId], references: [id])
  reservationId   String?
  reservation     Reservation? @relation(fields: [reservationId], references: [id])
  // sugestão de origem quando a ocorrência foi criada por "Converter em ocorrência"
  convertedFromId String?
  convertedFrom   Occurrence?  @relation("OccurrenceConversion", fields: [convertedFromId], references: [id])
  conversions     Occurrence[] @relation("OccurrenceConversion")

  events OccurrenceEvent[]

  @@index([propertyId])
  @@index([category])
  @@index([source])
  @@index([status])
  @@index([archivedAt])
  @@index([reportedById, createdAt])
}

/// Linha do tempo da ocorrência: toda ação grava um evento (quem, de→para, quando)
model OccurrenceEvent {
  id           String   @id @default(cuid())
  // CRIADA | STATUS | PRIORIDADE | ATRIBUIDA | COMENTARIO | RESOLVIDA | ARQUIVADA | REABERTA | EDITADA | CONVERTIDA
  type         String
  fromValue    String?
  toValue      String?
  message      String?
  actorLabel   String
  createdAt    DateTime @default(now())

  occurrenceId String
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?      @relation(fields: [actorId], references: [id])

  @@index([occurrenceId, createdAt])
}

model Inspection {
  id            String   @id @default(cuid())
  type          String
  notes         String?
  photos        String[]
  checklist     Json
  signedByGuest Boolean  @default(false)
  createdAt     DateTime @default(now())

  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
}

model InventoryItem {
  id         String   @id @default(cuid())
  name       String
  quantity   Int      @default(1)
  condition  String   @default("BOM")
  photoUrl   String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}

model GuestRequest {
  id        String   @id @default(cuid())
  type      String
  message   String
  status    String   @default("PENDENTE")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestId       String?
  guest         User?       @relation(fields: [guestId], references: [id])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  category    String
  phone       String?
  email       String?
  description String?
  logoUrl     String?
  whatsappUrl String?  // ex: https://wa.me/5585999887766
  externalUrl String?  // Google Maps, site, rota
  sortOrder   Int      @default(0) // ordem no painel e na tela do hóspede
  deliveryNote String? // instrução de entrega específica deste estabelecimento (senão usa a da casa)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  properties PropertyPartner[]
}

model PropertyPartner {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])

  @@id([propertyId, partnerId])
}

model MagicLink {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  type           String
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  active         Boolean   @default(true)

  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id])
  prestadorName  String?
  prestadorPhone String?

  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  guestName      String?

  createdById    String
  createdBy      User         @relation("MagicLinkCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
}

model Expense {
  id          String    @id @default(cuid())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  category    String    // LIMPEZA | MANUTENCAO | MATERIAL | OUTRO
  date        DateTime
  receiptUrl  String?
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  createdById  String
  createdBy    User     @relation("ExpenseCreator", fields: [createdById], references: [id])
}

model OwnerStatement {
  id           String    @id @default(cuid())
  month        Int
  year         Int
  grossRevenue Decimal   @db.Decimal(10, 2)
  commission   Decimal   @db.Decimal(10, 2)
  monthlyFee   Decimal   @db.Decimal(10, 2)
  expenses     Decimal   @db.Decimal(10, 2)
  netAmount    Decimal   @db.Decimal(10, 2)
  status       String    @default("PENDENTE") // PENDENTE | PAGO
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  type      String
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Canais (iCal) ───

/// Calendário importado de uma plataforma (Airbnb, Booking, Vrbo...)
model CalendarChannel {
  id         String             @id @default(cuid())
  platform   ChannelPlatform
  label      String
  importUrl  String
  active     Boolean            @default(true)
  lastSyncAt DateTime?
  lastStatus ChannelSyncStatus?
  lastError  String?
  createdAt  DateTime           @default(now())

  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([propertyId])
}

/// Ocupação do calendário: reservas dos canais, diretas e bloqueios. endDate = dia do check-out (exclusivo)
model Booking {
  id           String        @id @default(cuid())
  source       BookingSource
  externalUid  String?
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  status       BookingStatus @default(CONFIRMADA)
  guestName    String?
  guestContact String?
  guestsCount  Int?
  amount       Decimal?      @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  propertyId  String
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     CalendarChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([channelId, externalUid])
  @@index([propertyId, startDate])
}
